# Copy to .env and fill in. Never commit .env.
# Every variable the project will need is listed here up front, so nobody has
# to edit this file mid-hackathon. If you must add one, append it to the end of
# YOUR section only (see docs/PARALLEL_PLAN.md).

# ── Shared ────────────────────────────────────────────────────────────────
# mock = local terminal simulator (no Photon needed); live = real iMessage
PHOTON_MODE=mock
# Optional: path to your family file (defaults to data/family.json, then data/family.example.json)
FAMILY_FILE=

# ── User 1 (AndrewW-coder): Photon / relay / review ─────────────────────
# Advanced iMessage Kit (gRPC). Get both from the Photon dashboard (app.photon.codes) or the Photon booth.
# Address is host:port with NO https://, e.g. line-1.imsg.photon.codes:443
IMESSAGE_ADDRESS=
IMESSAGE_TOKEN=
IMESSAGE_TLS=true
# Plan B only (if Photon gives you Spectrum project credentials instead of a line token)
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# How long to wait for a bilingual reviewer before sending the best guess (ms)
REVIEW_TIMEOUT_MS=120000

# ── User 2 (reallyrealistic): translation / media / payments ───────────
# Claude (translation, intent parsing, photo explanations)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Translations below this confidence (0-1) go to a bilingual member for review
REVIEW_CONFIDENCE_THRESHOLD=0.75
# mock = fake transfers for the demo if sandbox access is slow; sandbox = Visa Direct sandbox
VISA_MODE=mock
VISA_USER_ID=
VISA_PASSWORD=
VISA_CERT_PATH=
VISA_KEY_PATH=
VISA_CA_PATH=
# Voice notes: speech-to-text / text-to-speech provider key (provider chosen by User 2)
SPEECH_PROVIDER=
SPEECH_API_KEY=
