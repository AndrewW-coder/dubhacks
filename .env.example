# Copy to .env and fill in. Never commit .env.
# Every variable the project will need is listed here up front, so nobody has
# to edit this file mid-hackathon. If you must add one, append it to the end of
# YOUR section only (see docs/PARALLEL_PLAN.md).

# ── Shared ────────────────────────────────────────────────────────────────
# mock = local terminal simulator (no Photon needed); live = real iMessage
PHOTON_MODE=mock
# Optional: path to your family file (defaults to data/family.json, then data/family.example.json)
FAMILY_FILE=

# ── User 1 (AndrewW-coder): Photon / relay / review ─────────────────────
# Old Advanced iMessage Kit line credentials. Unused since live.ts moved to Spectrum.
IMESSAGE_ADDRESS=
IMESSAGE_TOKEN=
IMESSAGE_TLS=true
# Spectrum (Photon's current SDK), used by PHOTON_MODE=live. Project ID is on the
# dashboard; get the secret with: npx -y @photon-ai/cli@latest projects secret --project <id>
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# How long to wait for a bilingual reviewer before sending the best guess (ms)
REVIEW_TIMEOUT_MS=120000

# ── User 2 (reallyrealistic): translation / media / payments ───────────
# AI for translation, money parsing and photo explanations. Pick ONE provider:
#   gemini (default when LLM_API_KEY is set; free key at aistudio.google.com → "Get API key")
#   anthropic (ANTHROPIC_API_KEY)  ·  openai-compatible (OpenAI, Groq, OpenRouter, DeepSeek, Ollama: set LLM_BASE_URL + LLM_MODEL)
TRANSLATE_PROVIDER=gemini
LLM_API_KEY=
# Optional: model (Gemini default gemini-3.8-flash, falls back to older flash models), base URL, effort, timeout
LLM_MODEL=
LLM_BASE_URL=
LLM_REASONING_EFFORT=
LLM_TIMEOUT_MS=
# Claude (only if TRANSLATE_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Translations below this confidence (0-1) go to a bilingual member for review
REVIEW_CONFIDENCE_THRESHOLD=0.75
# mock = fake transfers for the demo if sandbox access is slow; sandbox = Visa Direct sandbox
VISA_MODE=mock
VISA_USER_ID=
VISA_PASSWORD=
VISA_CERT_PATH=
VISA_KEY_PATH=
VISA_CA_PATH=
# Voice notes: speech-to-text / text-to-speech provider key (provider chosen by User 2)
SPEECH_PROVIDER=
SPEECH_API_KEY=
# Optional voice settings (defaults are fine): model names, TTS voice, ffmpeg location, test server
SPEECH_MODEL=
SPEECH_TTS_MODEL=
SPEECH_VOICE=
FFMPEG_PATH=
SPEECH_BASE_URL=
# Learned glossary file (default data/glossary.json; "off" = don't save, keeps demo runs repeatable)
GLOSSARY_FILE=
# Largest photo sent to Claude after conversion, in bytes (default 7500000; use 3750000 on Bedrock/Vertex)
IMAGE_MAX_BYTES=
# How long Bridge waits for a "yes" on a payment (ms, default 180000)
PAYMENT_CONFIRM_TIMEOUT_MS=
# Visa Direct sandbox extras (VISA_MODE=sandbox). Test card numbers come from Visa's sandbox docs — never real cards.
VISA_BASE_URL=
VISA_ACQUIRING_BIN=
VISA_ACQUIRER_COUNTRY=
VISA_TEST_SENDER_PAN=
VISA_TEST_RECIPIENT_PAN=
VISA_TIMEOUT_MS=

# ── Shopping (User 2: src/shop) ───────────────────────────────────────────
# Real product search via SerpApi Google Shopping (free tier at serpapi.com). Without a key,
# Bridge uses the fictional demo catalog in data/catalog.json (always works offline).
SERPAPI_API_KEY=
# serpapi | catalog (default: serpapi when SERPAPI_API_KEY is set, else catalog)
SHOP_SEARCH=
# Optional search tuning: country, language, location, timeout (defaults us / en / none / 12000)
SERPAPI_GL=
SERPAPI_HL=
SERPAPI_LOCATION=
SERPAPI_TIMEOUT_MS=
SERPAPI_BASE_URL=
# mock (default, fake order + ETA) | paylink (a real Visa checkout page, SANDBOX only: test cards,
# no real money; needs the VISA_ACCEPTANCE_* keys below) | sandbox (old Visa Direct stand-in)
SHOP_MODE=mock
# A buyer's auto-approve limit in USD when FamilyMember.shopLimitUsd isn't set (default 50)
SHOP_DEFAULT_LIMIT_USD=
# How long the family vote stays open, in ms (default 120000)
SHOP_VOTE_TIMEOUT_MS=
# Visa Acceptance (Cybersource) SANDBOX for SHOP_MODE=paylink. Free sandbox: developer.cybersource.com
# → "Create sandbox account". Then Business Center (businesscentertest.cybersource.com) →
# Payment Configuration → Key Management → Generate key → REST Shared Secret. Never commit these.
VISA_ACCEPTANCE_MERCHANT_ID=
VISA_ACCEPTANCE_KEY_ID=
VISA_ACCEPTANCE_SECRET_KEY=
# apitest.cybersource.com (default) or apitest.visaacceptance.com. Production hosts are refused.
VISA_ACCEPTANCE_HOST=
# How long the Visa link stays open, and how often Bridge checks it (ms; defaults 600000 / 4000)
PAYLINK_TIMEOUT_MS=
PAYLINK_POLL_MS=
